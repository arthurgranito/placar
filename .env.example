# Copie para .env.local (Next) e .env (Supabase CLI): `cp .env.example .env.local && cp .env.example .env`
# Nenhum destes arquivos vai para o git.

# --- Supabase (app) -------------------------------------------------------------
# URL da API do Supabase. Local: `make db-up` mostra a "API URL" (http://127.0.0.1:54321).
# Produção: painel do Supabase > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Chave publicável (sb_publishable_...). Local: "Publishable key" na saída de `make db-up`
# (ou `pnpm supabase status`). Produção: painel > Project Settings > API Keys.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Supabase (só servidor/testes, NUNCA no cliente) ----------------------------
# Chave secreta (sb_secret_...). Usada só pelos testes e2e para criar usuários pela API admin.
# Local: "Secret key" na saída de `pnpm supabase status`.
SUPABASE_SECRET_KEY=

# --- Login com Google (Supabase Auth) -------------------------------------------
# Lidas pelo `supabase start` (supabase/config.toml, [auth.external.google]).
# Crie em console.cloud.google.com > APIs e serviços > Credenciais > ID do cliente OAuth (Web).
# URI de redirecionamento autorizado local: http://127.0.0.1:54321/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# --- Testes e2e -----------------------------------------------------------------
# URL base que o Playwright abre (padrão: http://localhost:3000).
# PLAYWRIGHT_BASE_URL=http://localhost:3000
