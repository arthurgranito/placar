{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "placar",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // URLs de preview por versão (`wrangler versions upload --preview-alias pr-N`), usadas no preview.yml.
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "placar",
    },
  ],
  "observability": {
    "enabled": true,
  },
  // Cron Triggers (fechamento da semana, lembretes) entram nas Fases 7 e 11.
}
